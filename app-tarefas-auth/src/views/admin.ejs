<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Painel Admin</title>
</head>
<body>

<h1>Painel Administrativo</h1>

<h2>Usuários</h2>

<% usuarios.forEach(u => { %>
  <p>
    <%= u.nome %> -
    <%= u.email %> -
    <%= u.role %>
  </p>
<% }) %>

<hr>

<h2>Todas as tarefas</h2>

<% tarefas.forEach(t => { %>
  <p>
    #<%= t.id %> -
    <%= t.texto %> -
    <%= t.concluida ? "✅" : "⬜" %>
  </p>
<% }) %>

</body>
</html>